---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermeDestacat from '../components/TermeDestacat.astro';
import IndexAlfabetic from '../components/IndexAlfabetic.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../content.config';
import { CATEGORY_LABELS } from '../lib/categories';
import { withBase } from '../lib/url';

const termes = await getCollection('termes', ({ data }) => !data.draft);
const letters = [
  ...new Set(termes.flatMap((t) => [t.data.title.charAt(0).toUpperCase(), ...(t.data.lletresIndex ?? [])])),
].sort();
---

<BaseLayout
  title="Inici"
  ogTitle="Diccionari de ciberseguretat - entendre és fonamental per a estar segur"
  ogDescription="«Un atac de phishing ha desplegat un ransomware en diferents payloads per evitar la detecció de l'XDR». Si no ho has entès, per això existeix aquest glossari."
>
  <section style="margin-bottom: 2.5rem;">
    <h1>Recull de termes vinculats al món de la ciberseguretat.</h1>
    <p style="max-width: 60ch; color: var(--color-text-muted);">
      Un glossari en català planer que explica termes com <a href={withBase('termes/phishing/')}>phishing</a>,
      <a href={withBase('termes/ransomware/')}>ransomware</a>, <a href={withBase('termes/xss/')}>XSS</a> o
      <a href={withBase('termes/sniffing/')}>sniffing</a> perquè qualsevol persona els entengui — no cal ser
      expert per protegir-te.
    </p>
  </section>

  <TermeDestacat />

  <section style="margin: 2.5rem 0;">
    <h2>Explora per lletra</h2>
    <IndexAlfabetic letters={letters} />
  </section>

  <section>
    <h2>Explora per categoria</h2>
    <div class="grid grid-cards">
      {
        CATEGORIES.map((c) => (
          <a class="card" href={withBase(`categories/${c}/`)} style="display:block; text-decoration:none; color:inherit;">
            {CATEGORY_LABELS[c]}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
