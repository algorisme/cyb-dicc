---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermeCard from '../../components/TermeCard.astro';
import IndexAlfabetic from '../../components/IndexAlfabetic.astro';
import { getPublishedTermes } from '../../lib/termes';
import { buildDefinedTermSetJsonLd, buildBreadcrumbJsonLd } from '../../lib/jsonld';
import { withBase } from '../../lib/url';

const DESCRIPTION = 'Índex complet del glossari de ciberseguretat, ordenat alfabèticament.';

const termesRaw = await getPublishedTermes();
const termes = termesRaw
  .map((t) => ({
    id: t.id,
    title: t.data.title,
    summary: t.data.summary,
    lletresIndex: t.data.lletresIndex ?? [],
  }))
  .sort((a, b) => a.title.localeCompare(b.title, 'ca'));

const homeUrl = new URL(withBase(''), Astro.site).href;
const termesIndexUrl = new URL(Astro.url.pathname, Astro.site).href;

const jsonLd = [
  buildDefinedTermSetJsonLd({
    name: 'Diccionari de ciberseguretat',
    description: DESCRIPTION,
    url: termesIndexUrl,
    termes: termes.map((t) => ({
      title: t.title,
      url: new URL(withBase(`termes/${t.id}/`), Astro.site).href,
    })),
  }),
  buildBreadcrumbJsonLd([
    { name: 'Inici', url: homeUrl },
    { name: 'Tots els termes', url: termesIndexUrl },
  ]),
];

const grups = new Map<string, typeof termes>();
for (const t of termes) {
  const lletres = new Set([t.title.charAt(0).toUpperCase(), ...t.lletresIndex.map((l) => l.toUpperCase())]);
  for (const letter of lletres) {
    if (!grups.has(letter)) grups.set(letter, []);
    grups.get(letter)!.push(t);
  }
}
const letters = [...grups.keys()].sort();
---

<BaseLayout title="Tots els termes" description={DESCRIPTION} jsonLd={jsonLd}>
  <h1>Tots els termes</h1>

  <div style="position: sticky; top: 0; background: var(--color-bg); padding-block: 0.75rem; z-index: 1;">
    <IndexAlfabetic letters={letters} hrefPrefix="" />
  </div>

  {
    letters.map((letter) => (
      <section id={`letra-${letter}`} style="margin-top: 2rem;">
        <h2>{letter}</h2>
        <div class="grid grid-cards">
          {grups.get(letter)!.map((t) => (
            <TermeCard id={t.id} title={t.title} summary={t.summary} />
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
