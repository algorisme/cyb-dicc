---
import { withBase } from '../lib/url';
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';
---

<header class="site-header">
  <div class="wrap site-header-inner">
    <a class="brand" href={withBase('')}>Diccionari de ciberseguretat</a>

    <nav class="site-nav" aria-label="Navegació principal">
      <a href={withBase('termes/')}>Termes</a>
      <a href={withBase('categories/')}>Categories</a>
    </nav>

    <div class="site-header-actions">
      <SearchBox />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding-block: 0.75rem;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
    margin-right: auto;
  }

  .site-nav {
    display: flex;
    gap: 1rem;
  }

  .site-nav a {
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.92rem;
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-basis: 100%;
  }

  @media (min-width: 720px) {
    .site-header-actions {
      flex-basis: auto;
    }
  }
</style>
