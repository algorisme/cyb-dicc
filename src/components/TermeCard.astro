---
import { withBase } from '../lib/url';

interface Props {
  id: string;
  title: string;
  summary: string;
}

const { id, title, summary } = Astro.props;
---

<a class="card" href={withBase(`termes/${id}/`)} style="display:block; text-decoration:none; color:inherit;">
  <h3 style="margin:0 0 0.35rem;">{title}</h3>
  <p style="margin:0; color:var(--color-text-muted); font-size:0.92rem;">{summary}</p>
</a>
